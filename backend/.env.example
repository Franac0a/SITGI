PORT=4000

# Base de datos (valores de docker-compose.yml; con XAMPP usar root y clave vacía)
DB_NAME=citproyecto
DB_USER=sitgi
DB_PASSWORD=sitgi_dev
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql

# Obligatorio: clave larga y aleatoria. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

NODE_ENV=development

# URLs del frontend separadas por coma (para CORS cuando se accede por IP en red local)
# FRONTEND_URLS=http://192.168.1.10:5173
